DATABASE_URL=postgresql://otodom_user:your_password@localhost:5432/otodom_db

LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# LLM_BASE_URL=https://openrouter.ai/api/v1

SCREENING_MODEL=claude-haiku-4-5
EVALUATION_MODEL=claude-sonnet-5
# Zdjecia to najwiekszy skladnik wejscia: medium 655x491 to ~429 tokenow,
# small 314x236 to ~99 tokenow. Mniej zdjec = tanszy, ale slabiej udokumentowany werdykt.
LLM_MAX_IMAGES=8
LLM_IMAGE_VARIANT=medium
LLM_DOWNLOAD_IMAGES=false
# LLM_EFFORT dotyczy tylko modeli, ktore przyjmuja ten parametr.
# Haiku i Sonnet 4.5 go nie przyjmuja - dla nich nie jest wysylany.
# SCREENING_EFFORT / EVALUATION_EFFORT nadpisuja to per etap, wartosc 'none' wylacza.
LLM_EFFORT=medium
LLM_MAX_OUTPUT_TOKENS=8000

# Opis dluzszy niz tyle znakow jest obcinany w promptach obu etapow.
LLM_MAX_DESCRIPTION_CHARACTERS=4000

# Twardy bezpiecznik: po przekroczeniu tej kwoty w oknie 24h enricher przestaje wolac model.
# Puste = brak limitu.
ENRICHER_DAILY_BUDGET_USD=5

EVALUATION_PRICE_DRIFT_THRESHOLD=0.05
ENRICHER_CONCURRENCY=4
ENRICHER_CYCLE_PAUSE_SECONDS=300
ENRICHER_MAX_TRIES=3
ENRICHER_RETRY_PAUSE_SECONDS=10
