DATABASE_URL=postgresql://otodom_user:your_password@localhost:5432/otodom_db

# Haslo do UI i API. Puste = brak logowania. Zmiana wylogowuje wszystkie urzadzenia.
APP_PASSWORD=
# Publiczny adres HTTPS. Gdy ustawiony, zapytania po zwyklym HTTP (takze na gola porte) sa przekierowywane tutaj.
# APP_PUBLIC_URL=https://steve138-30138.wykr.es

LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# LLM_BASE_URL=https://openrouter.ai/api/v1

SCREENING_MODEL=claude-haiku-4-5
EVALUATION_MODEL=claude-sonnet-5
# Zdjecia to najwiekszy skladnik wejscia: medium 655x491 to ~429 tokenow,
# small 314x236 to ~99 tokenow. Mniej zdjec = tanszy, ale slabiej udokumentowany werdykt.
LLM_MAX_IMAGES=8
LLM_IMAGE_VARIANT=medium
LLM_DOWNLOAD_IMAGES=false
# LLM_EFFORT dotyczy tylko modeli, ktore przyjmuja ten parametr.
# Haiku i Sonnet 4.5 go nie przyjmuja - dla nich nie jest wysylany.
# SCREENING_EFFORT / EVALUATION_EFFORT nadpisuja to per etap, wartosc 'none' wylacza.
LLM_EFFORT=medium
LLM_MAX_OUTPUT_TOKENS=8000

# Opis dluzszy niz tyle znakow jest obcinany w promptach obu etapow.
LLM_MAX_DESCRIPTION_CHARACTERS=4000

# Twardy bezpiecznik: po przekroczeniu tej kwoty w oknie 24h enricher przestaje wolac model,
# takze w trakcie cyklu. Bez tej zmiennej limit wynosi 10 USD.
ENRICHER_DAILY_BUDGET_USD=5
# Osobny limit na oceny zamowione z asystenta (przycisk "Ocen ze zdjec").
ENRICHER_REQUEST_DAILY_BUDGET_USD=3

EVALUATION_PRICE_DRIFT_THRESHOLD=0.05
ENRICHER_CONCURRENCY=4
ENRICHER_CYCLE_PAUSE_SECONDS=300
ENRICHER_MAX_TRIES=3
ENRICHER_RETRY_PAUSE_SECONDS=10
# Co ile godzin enricher przelicza historię ogłoszeń, porównania z okolicą i flagi lokalizacji. 0 wyłącza.
MARKET_SIGNALS_INTERVAL_HOURS=6
# Miasta, wokół których enricher co RCN_REFRESH_DAYS dni pobiera transakcje mieszkań z RCN oraz drogi, kolej
# i lotniska z OpenStreetMap (przecinki). Puste wyłącza.
RCN_CITIES=Kraków
RCN_REFRESH_DAYS=30

# Asystent AI w wyszukiwarce. Uzywa LLM_PROVIDER i klucza z gory.
ASSISTANT_DAILY_BUDGET_USD=2
ASSISTANT_INTERPRET_MODEL=claude-haiku-4-5
ASSISTANT_RANK_MODEL=claude-sonnet-5
ASSISTANT_RANK_EFFORT=low
ASSISTANT_CANDIDATES=30
ASSISTANT_DESCRIPTION_CHARACTERS=800
